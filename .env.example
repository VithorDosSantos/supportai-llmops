# Copie para .env e ajuste. Nunca versione o .env.

# --- Geral ---
ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO
SEED=42
# Padrão: sqlite:///<raiz do projeto>/mlflow.db (necessário para o Model Registry)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Postgres + pgvector (docker compose usa os mesmos valores) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=supportai
DB_PASSWORD=supportai
DB_NAME=supportai

# --- LLM ---
# Provedor: ollama (local, grátis, padrão) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
LLM_OLLAMA_BASE_URL=http://localhost:11434

# Obrigatória apenas para o provedor correspondente
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
